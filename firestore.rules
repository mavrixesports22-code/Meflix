rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin security & settings: managed by admin console using Firebase directly
    match /admin_settings/{id} {
      allow read, write: if true;
    }

    // App release version configuration & security config
    match /app_config/{id} {
      allow read, write: if true;
    }

    // Device requests: registered by apps, managed and reviewed by admin console
    match /device_requests/{id} {
      allow read, write: if true;
    }

    // Whitelisted IPs
    match /whitelisted_ips/{id} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}

