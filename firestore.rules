rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Admin security & settings: managed by admin console using Firebase directly
    match /admin_settings/{id} {
      allow read, write: if signedIn();
    }

    // Device requests: registered by apps, managed and reviewed by admin console
    match /device_requests/{id} {
      allow read, write: if signedIn();
    }

    // App release version configuration: readable by apps, published by admin console
    match /app_config/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /whitelisted_ips/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if signedIn(); }
  }
}
