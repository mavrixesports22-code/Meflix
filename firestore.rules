rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && request.auth.uid == 'meflix-admin-console'
        && request.auth.token.admin == true
        && request.auth.token.pinVersion == get(/databases/$(database)/documents/admin_settings/security).data.pinVersion;
    }
    function owner(id) { return signedIn() && request.auth.uid == id; }
    match /admin_settings/{id} { allow read, write: if false; }
    match /admins/{uid} { allow read, write: if false; }
    match /device_requests/{id} {
      allow get: if admin() || owner(id);
      allow list: if admin();
      allow create: if owner(id)
        && request.resource.data.keys().hasOnly(['deviceId','ownerUid','legacyDeviceId','name','ip','platform','requestedAt','status'])
        && request.resource.data.deviceId == id && request.resource.data.ownerUid == id
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.platform is string && request.resource.data.platform.size() <= 100
        && request.resource.data.ip == '' && request.resource.data.requestedAt is number;
      allow update: if (admin() && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', ''))
        || (owner(id) && resource.data.ownerUid == id
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt','isWatching','currentTitle','currentEpisode','currentProgress','watchHistory'])
          && request.resource.data.get('watchHistory', []).size() <= 20);
      allow delete: if admin();
    }
    match /app_config/{id} {
      allow get: if id in ['version','version_tv','version_android','version_ios'];
      allow list: if false;
      allow create, update, delete: if admin();
    }
    match /whitelisted_ips/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
